.env
__pycache__/
*.pyc
venv/
data/*.lock
# pouso temporário de upload — o worker apaga assim que confirma o envio
# pro Drive; nada aqui deveria sobreviver de verdade (ver api/app.py)
media/*
!media/.gitkeep
# cache local por usuário: catalog.json (espelho do uploaded_files.json do
# Drive) + profile.json (tokens OAuth + IDs do Drive) — ver api/stores.py;
# não é fonte da verdade, e profile.json tem segredo (tokens), nunca commitar
data/users/
