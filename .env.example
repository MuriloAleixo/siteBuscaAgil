# Copie este arquivo para .env e preencha com sua chave real.
# Gere uma chave gratuita em https://aistudio.google.com/apikey
GEMINI_API_KEY=

# IA local (Ollama, container) - ver README, seção "Configurar IA Local
# (Ollama)". Se o container estiver fora do ar, cai automaticamente pro
# Gemini acima.
LOCAL_AI_ENABLED=true
OLLAMA_BASE_URL=http://localhost:11434
LOCAL_AI_TEXT_MODEL=qwen2.5:3b-instruct
LOCAL_AI_VISION_MODEL=moondream
LOCAL_AI_WHISPER_MODEL=tiny

# Login com Google + upload pro Google Drive do usuário (django-allauth).
# Crie em https://console.cloud.google.com/apis/credentials — veja o passo
# a passo completo no README.md ("Configurar Login E Drive Com O Google").
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Produção (deixe em branco/DEBUG=true em desenvolvimento). Veja o README,
# seção "Checklist De Produção".
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=
DJANGO_CSRF_TRUSTED_ORIGINS=
DJANGO_SECURE_SSL_REDIRECT=true
# true SÓ se houver um Nginx/proxy de verdade na frente terminando TLS e
# repassando o header X-Forwarded-Proto — nunca ative isso se o Django for
# acessado diretamente (sem proxy), senão um client poderia forjar o header.
DJANGO_BEHIND_PROXY=false
