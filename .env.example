# Copie este arquivo para .env e preencha com sua chave real.
# Gere uma chave gratuita em https://aistudio.google.com/apikey
GEMINI_API_KEY=

# IA local (Ollama, container) - ver README, seção "Configurar IA Local
# (Ollama)". Se o container estiver fora do ar, cai automaticamente pro
# Gemini acima. Modelos abaixo priorizam precisão; troque pra qwen2.5:3b-
# instruct / tiny se a máquina não aguentar o padrão (mais lento em CPU).
LOCAL_AI_ENABLED=true
OLLAMA_BASE_URL=http://localhost:11434
LOCAL_AI_TEXT_MODEL=qwen2.5:7b-instruct
LOCAL_AI_VISION_MODEL=moondream
LOCAL_AI_WHISPER_MODEL=small
# Timeout (segundos) das chamadas de CLASSIFICAÇÃO ao Ollama — 300s porque
# o 7b classificando transcrição longa de vídeo pode passar de 120s em CPU.
# Roda em background no worker, então esperar mais não trava nada pro
# usuário (diferente do timeout da busca, abaixo, que é síncrono na tela).
OLLAMA_TIMEOUT=300

# Modelo/timeout PRÓPRIOS da busca (uma consulta ≠ classificar um arquivo:
# dispara a CADA busca digitada, então precisa ser rápido, não o mesmo
# modelo pesado do LOCAL_AI_TEXT_MODEL acima) — ver
# scripts/local_ai/busca_analyzer_local.py. Sem isso, cada busca podia
# travar a tela por minutos se o Ollama estivesse ocupado classificando algo.
LOCAL_AI_SEARCH_MODEL=qwen2.5:3b-instruct
LOCAL_AI_SEARCH_TIMEOUT=10

# Teto de CPU/RAM pros containers ollama/worker (ver docker-compose.yml) —
# sem isso, classificar vídeo/arquivo pesado localmente pode consumir todos
# os núcleos/RAM do host e travar a máquina (WSL2 não limita sozinho).
# Baixe se sua máquina tiver poucos núcleos/RAM livre; suba se sobrar.
OLLAMA_CPUS=6
OLLAMA_MEM_LIMIT=6g
WORKER_CPUS=2
WORKER_MEM_LIMIT=3g
# Quantas tarefas de classificação o worker roda em paralelo. 1 é o seguro
# pra IA local (cada tarefa já usa vários núcleos sozinha via Ollama).
CELERY_WORKER_CONCURRENCY=1

# Login com Google + upload pro Google Drive do usuário (api/auth.py, OAuth2
# manual — sem allauth). Crie em
# https://console.cloud.google.com/apis/credentials — veja o passo a passo
# completo no README.md ("Configurar Login E Drive Com O Google"). O
# redirect URI cadastrado no Google Cloud Console precisa ser IGUAL ao valor
# abaixo (o proxy do nginx repassa /auth/callback pro serviço "api").
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost/auth/callback

# Produção (deixe em branco/FLASK_DEBUG=true em desenvolvimento).
FLASK_DEBUG=true
FLASK_SECRET_KEY=
