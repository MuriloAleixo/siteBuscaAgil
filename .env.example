# Copie este arquivo para .env e preencha com sua chave real.
# Gere uma chave gratuita em https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Login com Google + upload pro Google Drive do usuário (django-allauth).
# Crie em https://console.cloud.google.com/apis/credentials — veja o passo
# a passo completo no README.md ("Configurar Login E Drive Com O Google").
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Produção (deixe em branco/DEBUG=true em desenvolvimento). Veja o README,
# seção "Checklist De Produção".
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=
DJANGO_CSRF_TRUSTED_ORIGINS=
DJANGO_SECURE_SSL_REDIRECT=true
