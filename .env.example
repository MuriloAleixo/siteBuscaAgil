# Copie este arquivo para .env e preencha com sua chave real.
# Gere uma chave gratuita em https://aistudio.google.com/apikey
GEMINI_API_KEY=

# IA local (Ollama, container) - ver README, seção "Configurar IA Local
# (Ollama)". Se o container estiver fora do ar, cai automaticamente pro
# Gemini acima. Modelos abaixo priorizam precisão; troque pra qwen2.5:3b-
# instruct / tiny se a máquina não aguentar o padrão (mais lento em CPU).
LOCAL_AI_ENABLED=true
OLLAMA_BASE_URL=http://localhost:11434
LOCAL_AI_TEXT_MODEL=qwen2.5:7b-instruct
LOCAL_AI_VISION_MODEL=moondream
LOCAL_AI_WHISPER_MODEL=small

# Login com Google + upload pro Google Drive do usuário (api/auth.py, OAuth2
# manual — sem allauth). Crie em
# https://console.cloud.google.com/apis/credentials — veja o passo a passo
# completo no README.md ("Configurar Login E Drive Com O Google"). O
# redirect URI cadastrado no Google Cloud Console precisa ser IGUAL ao valor
# abaixo (o proxy do nginx repassa /auth/callback pro serviço "api").
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost/auth/callback

# Produção (deixe em branco/FLASK_DEBUG=true em desenvolvimento).
FLASK_DEBUG=true
FLASK_SECRET_KEY=
